# EmailJS Configuration
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/
# 1. Create an account at https://www.emailjs.com/
# 2. Create an Email Service (Gmail, Outlook, etc.)
# 3. Create an Email Template with these variables:
#    from_name, from_email, phone, language, level, contact_method, message
# 4. In the template, set "To Email" to: shalakkasalvi@gmail.com
# 5. Copy the Service ID, Template ID, and Public Key here

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Destination email for enquiries (also set in EmailJS template "To Email" field)
VITE_CONTACT_EMAIL=shalakkasalvi@gmail.com